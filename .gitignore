!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/tests/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editor
.claude/
openspec
.vscode
.agents/
.trae/

# env files (não versionar)
